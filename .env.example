# URL base del API (build time: si la cambiás, re-deployá en Vercel).
# Local:
VITE_API_URL=api_backend
# La IA (Benti) se consume vía POST /api/v1/ai/chat(stream) del backend;
# la API key de Gemini vive SOLO en el .env del backend (nunca acá).
# Producción (Render):
# VITE_API_URL=https://tu-api.onrender.com/api/v1

# WebSocket del chat (opcional): si no se setea, se deriva de VITE_API_URL
# manteniendo su prefijo /api/v1 y cambiando el esquema a ws(s).
# VITE_WS_URL=wss://tu-api.onrender.com/api/v1/chat
