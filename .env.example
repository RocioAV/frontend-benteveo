# URL base del API (build time: si la cambiás, re-deployá en Vercel).
# Local:
VITE_API_URL=http://localhost:3000/api/v1
# Producción (Render):
# VITE_API_URL=https://tu-api.onrender.com/api/v1

# WebSocket del chat (opcional): si no se setea, se deriva de VITE_API_URL
# (mismo host, esquema wss:// cuando la API es https).
# VITE_WS_URL=wss://tu-api.onrender.com
